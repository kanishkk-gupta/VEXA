# ============================================================
# VEXA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=VEXA
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# ----------------------------
# API server
# ----------------------------
API_HOST=0.0.0.0
API_PORT=8000

# ----------------------------
# Database
# Leave empty to run without a database (M1 foundation mode).
# Full format: postgresql+asyncpg://user:password@host:port/dbname
# ----------------------------
DATABASE_URL=

# ----------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ----------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# ----------------------------
# VEXA research settings
# ----------------------------
MAX_ITERATIONS=5

# ----------------------------
# M2 — Workspace & Tool Layer
# ----------------------------
# Root directory for isolated project workspaces.
# Use an absolute path in production. Relative = resolved from cwd.
WORKSPACE_ROOT=workspaces

# Execution sandbox backend: 'local' (default) or 'docker' (future)
SANDBOX_BACKEND=local

# Maximum seconds a sandboxed command may run
TOOL_EXEC_TIMEOUT_SECONDS=120

# Maximum captured stdout+stderr bytes per execution (default 1 MiB)
TOOL_MAX_OUTPUT_BYTES=1048576

# Maximum file size read_file will load (default 512 KiB)
TOOL_MAX_FILE_BYTES=524288

# Maximum files returned by list_files
TOOL_MAX_LIST_FILES=500

# Maximum search results returned
TOOL_MAX_SEARCH_RESULTS=200

